# Copy to .env. Every value has a working default for local dev; .env is optional.
ENV=dev
# Login with Discord: create an application at https://discord.com/developers/applications,
# add the redirect <PUBLIC_URL>/api/auth/discord/callback under OAuth2, and paste its id/secret.
# Leave empty to use dev login only.
PUBLIC_URL=http://localhost:8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Default timezone for newly created groups (each group stores its own).
DAY_TIMEZONE=America/New_York
# Concurrent submissions per worker container.
WORKER_MAX_JOBS=4
